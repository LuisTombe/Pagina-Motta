{
  "info": {
    "name": "Sprint 2 - Échele Camello (ADSO Grupo 8)",
    "description": "Colección de endpoints para probar Base de Datos, Autenticación JWT, Autorización por Roles/Permisos y Operaciones CRUD.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Salud del Servidor",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Auth - Registrar Usuario",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan Parada\",\n  \"correo\": \"juan@sena.edu.co\",\n  \"password\": \"Clave123*\",\n  \"rol\": \"EDITOR\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Auth - Login (Admin)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"admin@sena.edu.co\",\n  \"password\": \"Admin123*\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Auth - Perfil Actual",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "CRUD - Listar Ofertas",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ofertas"
      }
    },
    {
      "name": "CRUD - Crear Oferta",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Reparación de redes locales\",\n  \"descripcion\": \"Cableado estructurado y configuración de router en oficina.\",\n  \"categoria\": \"Redes\",\n  \"ubicacion\": \"Neiva, Huila\",\n  \"presupuesto\": 250000,\n  \"estado\": \"ABIERTA\"\n}"
        },
        "url": "{{baseUrl}}/api/ofertas"
      }
    },
    {
      "name": "CRUD - Consultar Oferta por ID",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ofertas/1"
      }
    },
    {
      "name": "CRUD - Actualizar Oferta",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Reparación de redes locales (Actualizado)\",\n  \"estado\": \"EN_PROCESO\",\n  \"presupuesto\": 280000\n}"
        },
        "url": "{{baseUrl}}/api/ofertas/1"
      }
    },
    {
      "name": "CRUD - Eliminar Oferta",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ofertas/1"
      }
    }
  ]
}
