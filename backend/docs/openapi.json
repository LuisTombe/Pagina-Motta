{
  "openapi": "3.0.3",
  "info": {
    "title": "API REST Sprint 2 — Échele Camello (ADSO Grupo 8)",
    "version": "1.0.0",
    "description": "Backend funcional del Sprint 2 con base de datos relacional (5 tablas), autenticación JWT, autorización basada en roles/permisos y operaciones CRUD sobre ofertas de servicio."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Servidor local de desarrollo"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Estado del servidor y base de datos",
        "responses": {
          "200": { "description": "Servicio operativo" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Registrar un nuevo usuario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "nombre": "Paula Vargas",
                "correo": "paula@sena.edu.co",
                "password": "MiPassword123",
                "rol": "EDITOR"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuario registrado" },
          "400": { "description": "Datos inválidos" },
          "409": { "description": "Correo ya registrado" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Iniciar sesión y obtener token JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "correo": "admin@sena.edu.co",
                "password": "Admin123*"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Inicio de sesión exitoso con token JWT" },
          "401": { "description": "Credenciales inválidas" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Consultar perfil y permisos del usuario autenticado",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Perfil del usuario autenticado" },
          "401": { "description": "Token faltante o inválido" }
        }
      }
    },
    "/api/ofertas": {
      "get": {
        "summary": "Listar ofertas de servicio (requiere permiso LEER)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "estado", "in": "query", "schema": { "type": "string", "enum": ["ABIERTA", "EN_PROCESO", "CERRADA"] } },
          { "name": "categoria", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Listado de ofertas" },
          "401": { "description": "No autenticado" },
          "403": { "description": "Sin permiso LEER" }
        }
      },
      "post": {
        "summary": "Crear una nueva oferta de servicio (requiere permiso CREAR)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "titulo": "Mantenimiento preventivo de computadores",
                "descripcion": "Limpieza interna, cambio de pasta térmica y optimización.",
                "categoria": "Soporte Técnico",
                "ubicacion": "Neiva, Huila",
                "presupuesto": 120000,
                "estado": "ABIERTA"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Oferta creada" },
          "400": { "description": "Validación fallida" },
          "401": { "description": "No autenticado" },
          "403": { "description": "Sin permiso CREAR" }
        }
      }
    },
    "/api/ofertas/{id}": {
      "get": {
        "summary": "Consultar oferta por ID (requiere permiso LEER)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Detalle de la oferta" },
          "401": { "description": "No autenticado" },
          "403": { "description": "Sin permiso LEER" },
          "404": { "description": "No encontrada" }
        }
      },
      "put": {
        "summary": "Actualizar oferta existente (requiere permiso ACTUALIZAR)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "titulo": "Mantenimiento preventivo actualizado",
                "estado": "EN_PROCESO",
                "presupuesto": 150000
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Oferta actualizada" },
          "401": { "description": "No autenticado" },
          "403": { "description": "Sin permiso ACTUALIZAR" },
          "404": { "description": "No encontrada" }
        }
      },
      "delete": {
        "summary": "Eliminar oferta por ID (requiere permiso ELIMINAR — solo ADMIN)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Oferta eliminada" },
          "401": { "description": "No autenticado" },
          "403": { "description": "Sin permiso ELIMINAR" },
          "404": { "description": "No encontrada" }
        }
      }
    }
  }
}
